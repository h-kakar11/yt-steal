{
  "manifest_version": 3,
  "name": "Ytsteal - YouTube Downloader",
  "short_name": "Ytsteal",
  "version": "2.0.0",
  "description": "Download YouTube videos and audio to your computer with one click or Alt+Shift+D.",
  "homepage_url": "https://github.com/h-kakar11/ytgrab",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Ytsteal",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "nativeMessaging",
    "notifications",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "lib/common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "download-video": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Download the video you're watching"
    },
    "download-audio": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Download only the audio of the video you're watching"
    }
  }
}
